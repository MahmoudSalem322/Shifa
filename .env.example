# Copy to .env.local and fill in.

# Shifaa .NET API. Defaults to the Render deployment when unset.
NEXT_PUBLIC_API_BASE=https://shifaa-api.onrender.com
SHIFA_API_BASE=https://shifaa-api.onrender.com

# Module 6 (health navigator) and Module 7 (prescription reader), server side
# only, never exposed to the browser. Without it the reader asks for manual
# entry and the navigator falls back to keyword search.
ANTHROPIC_API_KEY=

# Optional: models used by the prescription reader and navigator (default: claude-opus-5).
# SHIFA_PRESCRIPTION_MODEL=claude-opus-5
# SHIFA_NAVIGATOR_MODEL=claude-opus-5

# Optional: where the route handlers keep appointments, donations, matches,
# notifications and prescription reads (default: ./data). Needs a persistent disk.
# SHIFA_DATA_DIR=./data
